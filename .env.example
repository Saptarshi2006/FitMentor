# =============================================================================
# FitMentor — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the real values.
# .env is gitignored and must never be committed.

# --- Database (RDS) ---
DATABASE_URL=postgres://fitmentor:CHANGE_ME@your-rds-host.region.rds.amazonaws.com/fitmentor?sslmode=require

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API Shared Secret (server-to-server auth) ---
# Generate with: openssl rand -hex 32
API_SHARED_SECRET=

# --- Discord OAuth ---
# https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Session ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- App URLs ---
APP_URL=https://your-domain.pages.dev
API_URL=https://your-server-ip.sslip.io

# --- Cloudflare ---
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-aud-tag

# --- R2 (media storage) ---
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_HOST=

# --- AI ---
SUPERMEMORY_API_KEY=

# --- Payments (Polar) ---
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PREMIUM_PRODUCT_ID=
POLAR_PREMIUM_PRICE_ID=
POLAR_PRO_PRODUCT_ID=
POLAR_PRO_PRICE_ID=
